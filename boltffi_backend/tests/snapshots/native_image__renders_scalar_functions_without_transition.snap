===== com/boltffi/demo/BoltFFINativeImage.java =====
package com.boltffi.demo;

import java.util.Collections;
import java.util.List;
import org.graalvm.nativeimage.CurrentIsolate;
import org.graalvm.nativeimage.Isolate;
import org.graalvm.nativeimage.PinnedObject;
import org.graalvm.nativeimage.StackValue;
import org.graalvm.nativeimage.UnmanagedMemory;
import org.graalvm.nativeimage.c.CContext;
import org.graalvm.nativeimage.c.function.CEntryPoint;
import org.graalvm.nativeimage.c.function.CEntryPointLiteral;
import org.graalvm.nativeimage.c.function.CFunction;
import org.graalvm.nativeimage.c.function.CFunctionPointer;
import org.graalvm.nativeimage.c.function.CLibrary;
import org.graalvm.nativeimage.c.struct.CField;
import org.graalvm.nativeimage.c.struct.CStruct;
import org.graalvm.nativeimage.c.struct.SizeOf;
import org.graalvm.nativeimage.c.type.CCharPointer;
import org.graalvm.word.PointerBase;
import org.graalvm.word.WordFactory;

@CContext(BoltFFINativeImage.Directives.class)
@CLibrary(value = "demo_core", requireStatic = true)
final class BoltFFINativeImage {
    private BoltFFINativeImage() {}

    /** Build-time directives: the generated C header and its include directory. */
    static final class Directives implements CContext.Directives {
        @Override
        public List<String> getHeaderFiles() {
            return Collections.singletonList("<demo.h>");
        }

        @Override
        public List<String> getOptions() {
            return Collections.singletonList("-I" + System.getProperty("boltffi.include", "."));
        }
    }

    /** Direct declarations of the C ABI (or its pointer-ABI shims). */
    static final class Lib {
        private Lib() {}

        @CFunction(transition = CFunction.Transition.NO_TRANSITION)
        static native int boltffi_function_demo_add(int a, int b);

        @CFunction(transition = CFunction.Transition.NO_TRANSITION)
        static native boolean boltffi_function_demo_enabled(boolean flag);

        @CFunction(transition = CFunction.Transition.NO_TRANSITION)
        static native void boltffi_function_demo_refresh();
    }

    static int boltffi_function_demo_add(int a, int b) {
        return Lib.boltffi_function_demo_add(a, b);
    }

    static boolean boltffi_function_demo_enabled(boolean flag) {
        return Lib.boltffi_function_demo_enabled(flag);
    }

    static void boltffi_function_demo_refresh() {
        Lib.boltffi_function_demo_refresh();
    }
}
